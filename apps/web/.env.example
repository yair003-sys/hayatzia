# Copy to .env.local for local development. Never put production values in local files.
# Every name is validated in src/lib/env.ts. Values per environment live in Vercel (docs/ENVIRONMENTS.md).
NEXT_PUBLIC_APP_ENV=local

# Supabase (local CLI or the staging project; never production from a local run)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: sending notifications (reads other fans' push subscriptions)
SUPABASE_SECRET_KEY=

# Web Push (VAPID). Generate a pair once per environment; the private key is server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phone (SMS code) sign-in: on only after an SMS provider is connected in Supabase Auth
NEXT_PUBLIC_PHONE_AUTH=off

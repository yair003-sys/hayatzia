rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teamIds() { return ['mta','hta','mhf','bei','hbs','hhf','hjr','mpt','hpt','ikn','itb','hrg','mnt','snk']; }
    function validNick(n) { return n is string && n.size() <= 20; }
    function myTeam() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.team; }
    function rd() { return request.resource.data; }
    function onlyChanged(f) { return rd().diff(resource.data).affectedKeys().hasOnly([f]); }
    function bump(f, d) { return rd()[f] == resource.data[f] + d; }
    // a counter moves by one exactly when the fan's own marker document appears or disappears in the same write
    function toggled(f, mark) {
      return (bump(f, 1) && existsAfter(mark) && !exists(mark))
          || (bump(f, -1) && !existsAfter(mark) && exists(mark));
    }
    // Strict: only base64 characters after the prefix, so an image string can never carry HTML or script (security fix 2026-10-15).
    function validImg(img) { return img is string && img.size() < 700000 && img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'); }
    // Document ids are the 20-character ids Firestore generates; anything else could carry HTML into the page.
    function validId(id) { return id.matches('^[A-Za-z0-9]{20}$'); }
    function validText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }

    // A fan's profile. The team is chosen once and can never change.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && rd().keys().hasOnly(['team','nick','created'])
        && rd().team in teamIds()
        && validNick(rd().nick)
        && rd().created == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && rd().diff(resource.data).affectedKeys().hasOnly(['nick'])
        && validNick(rd().nick);
      allow delete: if false;
    }

    // Team chat: only fans locked to that team can read or write.
    match /teams/{team}/msgs/{msgId} {
      allow read: if signedIn() && myTeam() == team;
      allow create: if signedIn() && myTeam() == team
        && rd().keys().hasOnly(['uid','nick','text','t'])
        && rd().uid == request.auth.uid
        && validNick(rd().nick)
        && validText(rd().text, 200)
        && rd().t == request.time;
      allow update, delete: if false;
    }

    // Player ratings: one rating per fan per player, plus a running total per player.
    match /teams/{team}/ratings/{pid} {
      function byPath() { return /databases/$(database)/documents/teams/$(team)/ratings/$(pid)/by/$(request.auth.uid); }
      function ov(f) { return resource == null ? 0 : resource.data.get(f, 0); }
      function nv(f) { return rd().get(f, 0); }
      function one(c) { return c ? 1 : 0; }
      function dOk(k, a, b) { return nv('d' + string(k)) == ov('d' + string(k)) + one(a == k) - one(b == k); }
      function consistent(a, b) {
        return a != b
          && nv('sum') == ov('sum') + a - b
          && nv('cnt') == ov('cnt') + one(a > 0) - one(b > 0)
          && dOk(1, a, b) && dOk(2, a, b) && dOk(3, a, b) && dOk(4, a, b) && dOk(5, a, b);
      }
      allow read: if signedIn() && myTeam() == team;
      allow create, update: if signedIn() && myTeam() == team
        && rd().keys().hasOnly(['sum','cnt','d1','d2','d3','d4','d5'])
        && consistent(existsAfter(byPath()) ? getAfter(byPath()).data.s : 0,
                      exists(byPath()) ? get(byPath()).data.s : 0);
      allow delete: if false;

      match /by/{uid} {
        function aggPath() { return /databases/$(database)/documents/teams/$(team)/ratings/$(pid); }
        function aggOld() { return exists(aggPath()) ? get(aggPath()).data.get('sum', 0) : 0; }
        function aggNew() { return getAfter(aggPath()).data.get('sum', 0); }
        function valid() {
          return rd().keys().hasOnly(['s','txt','nick','t'])
            && rd().s is int && rd().s >= 1 && rd().s <= 5
            && rd().txt is string && rd().txt.size() <= 200
            && validNick(rd().nick)
            && rd().t == request.time;
        }
        allow read: if signedIn() && myTeam() == team;
        allow create: if signedIn() && request.auth.uid == uid && myTeam() == team && valid()
          && aggNew() == aggOld() + rd().s;
        allow update: if signedIn() && request.auth.uid == uid && myTeam() == team && valid()
          && (rd().s == resource.data.s || aggNew() == aggOld() + rd().s - resource.data.s);
        allow delete: if signedIn() && request.auth.uid == uid
          && aggNew() == aggOld() - resource.data.s;
      }
    }

    // Stand photos: the team's own gallery. Only that team's fans see it.
    match /teams/{team}/photos/{phid} {
      function photoPath() { return /databases/$(database)/documents/teams/$(team)/photos/$(phid); }
      allow read: if signedIn() && myTeam() == team;
      allow create: if signedIn() && myTeam() == team && validId(phid)
        && rd().keys().hasOnly(['uid','nick','img','cap','t','likes','ncm'])
        && rd().uid == request.auth.uid
        && validNick(rd().nick)
        && validImg(rd().img)
        && rd().cap is string && rd().cap.size() <= 120
        && rd().t == request.time
        && rd().likes == 0 && rd().ncm == 0;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && myTeam() == team && (
        (onlyChanged('likes') && toggled('likes', /databases/$(database)/documents/teams/$(team)/photos/$(phid)/likes/$(request.auth.uid)))
        || (onlyChanged('ncm') && bump('ncm', 1))
      );
      match /likes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && rd().keys().hasOnly(['t'])
          && getAfter(photoPath()).data.likes == get(photoPath()).data.likes + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(photoPath()).data.likes == get(photoPath()).data.likes - 1;
      }
      match /cm/{mid} {
        allow read: if signedIn() && myTeam() == team;
        allow create: if signedIn() && myTeam() == team
          && rd().keys().hasOnly(['uid','nick','text','t'])
          && rd().uid == request.auth.uid
          && validNick(rd().nick)
          && validText(rd().text, 120)
          && rd().t == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // The square: one shared feed for the whole league.
    match /clips/{cid} {
      function clipPath() { return /databases/$(database)/documents/clips/$(cid); }
      function mark(kind) { return /databases/$(database)/documents/clips/$(cid)/$(kind)/$(request.auth.uid); }
      allow read: if signedIn();
      allow create: if signedIn() && validId(cid)
        && rd().keys().hasOnly(['uid','nick','tid','img','cap','tags','t','likes','resp','ncm','once','views'])
        && rd().get('once', false) is bool && rd().get('views', 0) == 0
        && rd().uid == request.auth.uid
        && rd().tid == myTeam()
        && validNick(rd().nick)
        && validImg(rd().img)
        && rd().cap is string && rd().cap.size() <= 120
        && rd().tags is string && rd().tags.size() <= 60
        && rd().t == request.time
        && rd().likes == 0 && rd().resp == 0 && rd().ncm == 0;
      // the owner can delete any time; after 24 hours any fan may clear an expired post
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.t < request.time - duration.value(24, 'h'));
      allow update: if signedIn() && (
        (onlyChanged('likes') && toggled('likes', mark('likes')))
        || (onlyChanged('views') && resource.data.get('once', false) == true && resource.data.uid != request.auth.uid
            && bump('views', 1) && existsAfter(mark('seen')) && !exists(mark('seen')))
        || (onlyChanged('resp') && myTeam() != resource.data.tid && toggled('resp', mark('resp')))
        || (onlyChanged('ncm') && bump('ncm', 1))
      );

      // one like and one "respect" per fan, kept in step with the counters above
      match /likes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && rd().keys().hasOnly(['t'])
          && getAfter(clipPath()).data.likes == get(clipPath()).data.likes + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(clipPath()).data.likes == get(clipPath()).data.likes - 1;
      }
      match /resp/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && rd().keys().hasOnly(['t'])
          && getAfter(clipPath()).data.resp == get(clipPath()).data.resp + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(clipPath()).data.resp == get(clipPath()).data.resp - 1;
      }
      // view-once: who already watched, kept in step with the views counter
      match /seen/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && rd().keys().hasOnly(['t'])
          && getAfter(clipPath()).data.views == get(clipPath()).data.views + 1;
        allow update, delete: if false;
      }
      match /cm/{mid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && rd().keys().hasOnly(['uid','nick','tid','text','t'])
          && rd().uid == request.auth.uid
          && rd().tid == myTeam()
          && validNick(rd().nick)
          && validText(rd().text, 150)
          && rd().t == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Encryption keys: one public key per device. Only the owner publishes; any signed-in fan can read public keys.
    match /keys/{uid}/dev/{dev} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && rd().keys().hasOnly(['pub','t'])
        && rd().pub is string && rd().pub.size() < 400
        && rd().t == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Private conversations between two fans of the same team. The messages inside are end-to-end encrypted:
    // the server only ever stores ciphertext.
    match /dms/{tid} {
      function okPair(m) {
        return m is list && m.size() == 2 && m[0] < m[1] && tid == m[0] + '_' + m[1]
          && request.auth.uid in m
          && get(/databases/$(database)/documents/users/$(m[0])).data.team == get(/databases/$(database)/documents/users/$(m[1])).data.team;
      }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && rd().keys().hasOnly(['members','nicks','last','lastFrom'])
        && okPair(rd().members)
        && (resource == null || rd().members == resource.data.members)
        && rd().nicks is map && rd().nicks.size() <= 2
        && rd().lastFrom == request.auth.uid
        && rd().last == request.time;
      allow delete: if false;
      match /m/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/dms/$(tid)).data.members;
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/dms/$(tid)).data.members
          && rd().keys().hasOnly(['from','sd','t','iv','ct','wk'])
          && rd().from == request.auth.uid
          && rd().sd is string && rd().sd.size() < 40
          && rd().iv is string && rd().iv.size() < 40
          && rd().ct is string && rd().ct.size() < 4000
          && rd().wk is map && rd().wk.size() <= 20
          && rd().t == request.time;
        allow update, delete: if false;
      }
    }

    // Reports go to the moderators only. Nobody can read them from the app.
    match /reports/{rid} {
      allow create: if signedIn()
        && rd().keys().hasOnly(['uid','kind','ref','reason','note','t'])
        && rd().uid == request.auth.uid
        && rd().kind is string && rd().kind.size() <= 20
        && rd().ref is string && rd().ref.size() <= 100
        && rd().reason is string && rd().reason.size() <= 60
        && rd().note is string && rd().note.size() <= 120
        && rd().t == request.time;
      allow read, update, delete: if false;
    }
  }
}
